{% for domain in domains %}
# Configuration for {{domain.name}} using HTTP. Certificate challenges stay on
# the requested host, everything else goes to https://{{domain.hostname}}.
server {
  listen 80;
  listen [::]:80;

  server_name {{ ([domain.hostname] + (domain.aliases | default([]))) | join(' ') }};
  server_tokens off;

  include /etc/nginx/conf.d/block-probes.inc;

  # Required by letsencrypt certbot to acquire certificate
  location /.well-known/acme-challenge/ {
      root /var/www/certbot;
  }

  location / {
    return 301 https://{{domain.hostname}}$request_uri;
  }
}
{% endfor %}
