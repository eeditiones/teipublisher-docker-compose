services:
  # Copies a static busybox into a volume. The eXist-db images are distroless,
  # so the publisher entrypoint needs it to run the password setup script.
  exist-init:
    image: busybox:stable-musl
    command: ["cp", "/bin/busybox", "/exist-init/bin/busybox"]
    volumes:
      - exist-init-bin:/exist-init/bin
  publisher:
{% if publisher.apps | default([]) | length > 0 %}
    image: teipublisher-local:latest
    build:
      context: ${BUILD_CONTEXT:-.}
      dockerfile: Dockerfile
{% else %}
    image: {{ publisher.image | default('ghcr.io/eeditiones/jinks:latest') }}
{% endif %}
    restart: always
    # Without a cap the JVM may grow until the kernel kills it (exit 137).
    # Together with MaxRAMPercentage below the heap stays inside the limit and
    # leaves room for FOP and native memory.
    mem_limit: {{ publisher.memory | default('4g') }}
    memswap_limit: {{ publisher.memory | default('4g') }}
    # Starts eXist-db and sets the admin (and tei) password from .env, but only
    # while the data volume still has an empty admin password.
    entrypoint: ["/exist-init/bin/busybox", "sh", "/exist-init/entrypoint.sh"]
    stop_grace_period: 60s
    environment:
      EXIST_ADMIN_PASSWORD: ${EXIST_ADMIN_PASSWORD:-}
      EXIST_TEI_PASSWORD: ${EXIST_TEI_PASSWORD:-}
      # Who may run XQuery sent to eXist's REST interface (?_query=, ?_xpath=,
      # POSTed queries): disabled, authenticated or enabled.
      EXIST_REST_SUBMISSION: {{ publisher.rest_submission | default('disabled') }}
      # Same as the image default, except MaxRAMPercentage (75 in the image).
      # A heap OOM exits via ExitOnOutOfMemoryError and the container restarts.
      JAVA_TOOL_OPTIONS: >-
        -Dfile.encoding=UTF8
        -Dsun.jnu.encoding=UTF-8
        -Djava.awt.headless=true
        -Dorg.exist.db-connection.cacheSize=256M
        -Dorg.exist.db-connection.pool.max=20
        -Dlog4j.configurationFile=/exist/etc/log4j2.xml
        -Dexist.home=/exist
        -Dexist.configurationFile=/exist/etc/conf.xml
        -Djetty.home=/exist
        -Dexist.jetty.config=/exist/etc/jetty/standard.enabled-jetty-configs
        -XX:+UseStringDeduplication
        -XX:+UseContainerSupport
        -XX:MaxRAMPercentage=65.0
        -XX:+ExitOnOutOfMemoryError
      JDK_JAVA_OPTIONS: >-
        -Dteipublisher.ner-endpoint=http://ner:8001
        -Dteipublisher.context-path={{ publisher.context_path }}
        -Dteipublisher.proxy-caching={{ publisher.caching_support | default(false) | lower }}
    volumes:
      # database files will be stored in a volume to avoid data loss
      # when the service is updated
      - /exist/data
      - exist-init-bin:/exist-init/bin:ro
      - ./exist-init/entrypoint.sh:/exist-init/entrypoint.sh:ro
      - ./exist-init/set-passwords.sh:/exist-init/set-passwords.sh:ro
      # uncomment to map eXist-db backups to local directory
      # - ./backup:/exist/backup
    ports:
      - 127.0.0.1:8080:8080
    depends_on:
      exist-init:
        condition: service_completed_successfully
{% if services.ner %}
      ner:
        condition: service_started
  ner:
    # image will be pulled from github
    image: ghcr.io/eeditiones/tei-publisher-ner/teipublisher-ner:master
    restart: always
{% endif %}
  frontend:
    image: nginx:alpine
    volumes:
      - ./nginx/conf/:/etc/nginx/conf.d/:rw
      - ./nginx/cache:/var/cache/nginx/:rw
      - ./certbot/www:/var/www/certbot/:ro
      - ./certbot/conf/:/etc/nginx/ssl/:ro
    ports:
      - 80:80
      - 443:443
    depends_on:
      - publisher
{% if services.iiif %}
      - cantaloupe
{% endif %}
    restart: always
  certbot:
    image: certbot/certbot:latest
    volumes:
      - ./certbot/www/:/var/www/certbot/:rw
      - ./certbot/conf/:/etc/letsencrypt/:rw
{% if services.iiif %}
  cantaloupe:
    image: islandora/cantaloupe:2.0.10
    environment:
      CANTALOUPE_FILESYSTEMSOURCE_BASICLOOKUPSTRATEGY_PATH_PREFIX: /images/
      CANTALOUPE_SOURCE_STATIC: FilesystemSource
      CANTALOUPE_ENDPOINT_ADMIN_ENABLED: false
      CANTALOUPE_ENDPOINT_ADMIN_SECRET: my_admin_pass
    volumes:
      - ${IIIF_IMAGES:-./iiif}:/images
    restart: always
    # comment in to enable access to cantaloupe on port 8182, including admin interface
    # ports:
    #   - 8182:8182
{% endif %}

volumes:
  exist-init-bin:
