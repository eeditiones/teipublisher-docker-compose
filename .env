# Image to run for the publisher service. Defaults to the latest jinks release
# without additional apps.
PUBLISHER_IMAGE=ghcr.io/eeditiones/jinks:latest
# eXist-db path the root of the server will be mapped to. Specifying a path here
# will map the root to one single app; other apps stay reachable below /exist/apps/.
# Change to empty string if you want to expose the entire database.
ROOT_PATH=/exist/apps/jinks
# App context path: set to 'auto' if apps should be exposed under their full path
# (e.g. /exist/apps/tei-publisher), empty if a single app is mapped to the root.
CONTEXT_PATH=auto
# Name of the server - irrelevant on localhost
SERVER_NAME=example.com
# Directory in which images are stored for the IIIF service
IIIF_IMAGES=./iiif
# Memory limit for the publisher container. The Java heap is set to 65% of it.
MEM_LIMIT=4g
# Applied only when a fresh data volume still has an empty eXist admin password.
# A reused volume is left unchanged. Leave EXIST_TEI_PASSWORD empty to only set
# the admin password. Quote values that contain spaces or '#'.
# Write a literal $ as $$ so Compose does not interpolate it.
EXIST_ADMIN_PASSWORD=
EXIST_TEI_PASSWORD=
# Who may run XQuery sent to eXist's REST interface: disabled, authenticated or enabled.
EXIST_REST_SUBMISSION=disabled

# The settings below are only used by docker-compose.build.yml, which builds
# an app on top of jinks instead of using the prebuilt image.
# Directory or repository URL containing the Dockerfile
BUILD_CONTEXT=.
# use one of the below instead if you want to build from an external git repository (needs a Dockerfile):
# BUILD_CONTEXT=https://github.com/eeditiones/tei-publisher-app.git#master
# if the repo is not public, you may need to provide an ACCESS_TOKEN
# BUILD_CONTEXT=https://${ACCESS_TOKEN_NAME}:${ACCESS_TOKEN_VALUE}@gitlab.com/xxx/xxx.git
# Image the app is added to
BASE_IMAGE=ghcr.io/eeditiones/jinks:latest
# Name of the custom app to include - should correspond to the name of the repository
APP_NAME=tei-publisher-app
# Tag or branch to build
APP_TAG_OR_BRANCH=master
# GIT repository to clone the app from
APP_REPO=https://github.com/eeditiones/tei-publisher-app.git
# When building from a Dockerfile located in a private repo, you may need to set access tokens
ACCESS_TOKEN_NAME=xxx
ACCESS_TOKEN_VALUE=yyy
