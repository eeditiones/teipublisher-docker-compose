# Configuration for TEI Publisher with virtual host and SSL.
# Rename to default.ssl.conf.template once certificates have been acquired.

server {
  listen 443 ssl;
  listen [::]:443 ssl;

  server_name ${SERVER_NAME};

  ssl_certificate /etc/nginx/ssl/live/${SERVER_NAME}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/live/${SERVER_NAME}/privkey.pem;

  include /etc/nginx/conf.d/block-probes.inc;
  include /etc/nginx/conf.d/publisher-locations.inc;
}
