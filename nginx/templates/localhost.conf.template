# Default configuration for TEI Publisher running on localhost
# Just http, no https.
# Rate limits, bot and probe blocking are defined in conf.d/00-limits.conf,
# the proxy cache in conf.d/00-cache.conf.

gzip on;
gzip_disable "MSIE [1-6]\.";

server {
  listen 80;
  listen [::]:80;

  include /etc/nginx/conf.d/block-probes.inc;
  include /etc/nginx/conf.d/publisher-locations.inc;
}
