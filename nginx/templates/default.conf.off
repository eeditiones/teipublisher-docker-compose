# Configuration for TEI Publisher with virtual host and SSL.
# Rename to default.conf.template (together with default.ssl.conf.off) to enable.

server {
  listen 80;
  listen [::]:80;

  server_name ${SERVER_NAME};
  server_tokens off;

  include /etc/nginx/conf.d/block-probes.inc;

  # Required by letsencrypt certbot to acquire certificate
  location /.well-known/acme-challenge/ {
      root /var/www/certbot;
  }

  location / {
    return 301 https://${SERVER_NAME}$request_uri;
  }
}
