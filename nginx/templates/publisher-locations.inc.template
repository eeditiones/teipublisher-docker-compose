# Locations shared by the localhost and SSL server blocks. Generated from
# nginx/templates/publisher-locations.inc.template; ${ROOT_PATH} is the eXist-db
# path the root of the server is mapped to. Not named *.conf so nginx does not
# load it at http level.

# The /db/apps collection itself: without this, eXist's REST interface lists
# all installed apps. Only reachable if ROOT_PATH is empty.
location ~ ^/exist/apps/?$ {
  return 404;
}

# Uncomment to make admin and development apps unreachable through the proxy
# (recommended for production). They stay reachable on port 8080 directly.
# Remove the app ROOT_PATH points to (jinks by default) from the list.
# Must stay the first regex location so it wins over the /exist/apps/ ones below.
# location ~ ^/exist/apps/(eXide|jinks|dashboard|monex|packageservice|doc|fundocs)(/|$) {
#   return 404;
# }

# Uncomment to block eXist-db's REST, RESTXQ, XML-RPC and WebDAV interfaces.
# They are only exposed through the proxy if ROOT_PATH is empty.
# location ~ ^/exist/(rest|restxq|xmlrpc|webdav)(/|$) {
#   return 404;
# }

# The homepage is rendered by eXist on every request and sent with
# Cache-Control: no-cache. Cache the finished HTML for a short time so the
# browser is not left blank while that render runs. lang is read from the
# cookie as well as the query string, so it is part of the key.
location = /index.html {
    proxy_pass http://docker-publisher${ROOT_PATH}$request_uri;
    proxy_redirect http://$host${ROOT_PATH}/ /;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Host $server_name;
    proxy_ssl_server_name on;
    proxy_cookie_path /exist /;
    client_max_body_size  512m;

    proxy_cache page_cache;
    proxy_cache_key "$scheme$host$request_uri|$cookie_lang";
    proxy_cache_valid 200 10m;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 60s;
    proxy_cache_use_stale updating error timeout invalid_header http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_ignore_headers Cache-Control Expires Vary Set-Cookie;
    proxy_hide_header Cache-Control;
    proxy_hide_header Vary;
    proxy_cache_bypass $http_authorization;
    proxy_no_cache $http_authorization;
    add_header X-Proxy-Cache $upstream_cache_status always;
    add_header Cache-Control "public, max-age=60" always;
}

location / {
  proxy_pass http://docker-publisher${ROOT_PATH}$request_uri;
  proxy_redirect http://$host${ROOT_PATH}/ /;
  proxy_set_header   Host $host;
  proxy_set_header   X-Real-IP $remote_addr;
  proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header   X-Forwarded-Host $server_name;
  proxy_read_timeout 5m; # wait max 5 minutes for database to respond
  proxy_cookie_path /exist /;
  client_max_body_size  512m;
}

# Cache generated exports. Regex locations are checked in order, so the
# /exist/apps/ variants must come before the generic ^/exist/apps/ location.
location ~* ^/exist/apps/([^/]+)/api/document/.+/(pdf|epub|print|tex|docx)$ {
  proxy_pass http://docker-publisher$request_uri;
  proxy_redirect http://$host/exist/apps/$1/ /exist/apps/$1/;
  include /etc/nginx/conf.d/document-block-bots.inc;
  include /etc/nginx/conf.d/document-cache-params.inc;
}

location ~* ^/exist/apps/([^/]+)/api/document/.+/md$ {
  proxy_pass http://docker-publisher$request_uri;
  proxy_redirect http://$host/exist/apps/$1/ /exist/apps/$1/;
  include /etc/nginx/conf.d/document-cache-params.inc;
}

location ~* ^/exist/apps/([^/]+)/api/parts/ {
  proxy_pass http://docker-publisher$request_uri;
  proxy_redirect http://$host/exist/apps/$1/ /exist/apps/$1/;
  proxy_set_header   Host $host;
  proxy_set_header   X-Real-IP $remote_addr;
  proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header   X-Forwarded-Host $server_name;
  proxy_read_timeout 5m;
  proxy_cookie_path /exist /exist;
  client_max_body_size  512m;

  expires 7d; # time for client to recheck
  proxy_cache_key "$request_method$uri$is_args$args";
  proxy_cache page_cache;
  proxy_cache_valid 200 301 302 304 7d;
  proxy_cache_valid 400 401 0m;
  proxy_cache_valid any 1s;
  proxy_cache_lock on; # concurrent requests will be serialized
  proxy_cache_min_uses 1;
  proxy_cache_revalidate on;
  proxy_ignore_headers Set-Cookie Cache-Control Vary;
  proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
  add_header X-Proxy-Cache $upstream_cache_status;
}

location ~* /api/document/.+/(pdf|epub|print|tex|docx)$ {
  proxy_pass http://docker-publisher${ROOT_PATH}$request_uri;
  proxy_redirect http://$host${ROOT_PATH}/ /;
  include /etc/nginx/conf.d/document-block-bots.inc;
  include /etc/nginx/conf.d/document-cache-params.inc;
}

location ~* /api/document/.+/md$ {
  proxy_pass http://docker-publisher${ROOT_PATH}$request_uri;
  proxy_redirect http://$host${ROOT_PATH}/ /;
  include /etc/nginx/conf.d/document-cache-params.inc;
}

# Other apps in the database (e.g. apps generated by jinks) stay reachable
# under their full path when the root is mapped to a single app.
location ~ ^/exist/apps/([^/]+) {
  proxy_pass http://docker-publisher$request_uri;
  proxy_redirect http://$host/exist/apps/$1/ /exist/apps/$1/;
  proxy_set_header   Host $host;
  proxy_set_header   X-Real-IP $remote_addr;
  proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header   X-Forwarded-Host $server_name;
  proxy_read_timeout 5m;
  proxy_cookie_path /exist /exist;
  client_max_body_size  512m;
}

location ^~ /api/parts/ {
  proxy_pass http://docker-publisher${ROOT_PATH}$request_uri;
  proxy_redirect http://$host${ROOT_PATH}/ /;
  proxy_set_header   Host $host;
  proxy_set_header   X-Real-IP $remote_addr;
  proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header   X-Forwarded-Host $server_name;
  proxy_read_timeout 5m; # wait max 5 minutes for database to respond
  proxy_cookie_path /exist /;
  client_max_body_size  512m;

  expires 7d; # time for client to recheck
  proxy_cache_key "$request_method$uri$is_args$args";
  proxy_cache page_cache;
  proxy_cache_valid 200 301 302 304 7d;
  proxy_cache_valid 400 401 0m;
  proxy_cache_valid any 1s;
  proxy_cache_lock on; # concurrent requests will be serialized
  proxy_cache_min_uses 1;
  proxy_cache_revalidate on;
  proxy_ignore_headers Set-Cookie Cache-Control Vary;
  proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
  add_header X-Proxy-Cache $upstream_cache_status;
}

location /iiif {
  proxy_pass http://docker-cantaloupe$request_uri;
  proxy_redirect off;
}
